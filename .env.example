# Optional GitHub token raises API limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=

# Public canonical URL used by search engines and social previews.
NEXT_PUBLIC_SITE_URL=https://www.solo.engineer

# Curated public technical profiles. Add comma-separated Bluesky handles.
BLUESKY_ACTORS=bsky.app,jay.bsky.team,atproto.com

# Optional: configure private Discord channels locally. No Discord UI is shown.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_IDS=

# Crawler/API persistence. Run `docker compose -f infra/docker-compose.yml up -d`.
DATABASE_URL=postgresql://signal:signal_dev_password@127.0.0.1:5432/signal
API_HOST=127.0.0.1
API_PORT=3003
INGEST_INTERVAL_MS=900000
