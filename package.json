{
  "name": "signal-desk",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "api:dev": "tsx apps/api/src/index.ts",
    "worker:dev": "tsx apps/worker/src/index.ts",
    "worker:once": "tsx apps/worker/src/index.ts --once",
    "test:services": "tsx --test apps/api/src/**/*.test.ts packages/adapters/src/**/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.20",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.1",
    "lucide-react": "^0.576.0",
    "next": "^16.3.0",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.3.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.3"
  }
}
